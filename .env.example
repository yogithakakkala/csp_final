# ── Frontend (bundled into the site; safe to expose) ──────────────────────
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"   # or the legacy anon key

# ── Server-only (set these in Vercel → Settings → Environment Variables) ─
# SachiBot AI. Set ONE of these. Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# GROQ_API_KEY=""
# OPENROUTER_API_KEY=""
# AI_MODEL=""            # optional override, e.g. gemini-2.5-flash

# Staff key. The real check happens in the database (public.app_secrets, default 4040).
# This is only used by the /api/claim-staff fallback for databases without that migration.
STAFF_SIGNUP_KEY="4040"
# Needed by /api/claim-staff and scripts/import-osm-centers.mjs. NEVER prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=""
